
package com.example.ad_block

import android.app.Notification
import android.app.NotificationChannel
import android.app.NotificationManager
import android.content.Intent
import android.net.VpnService
import android.os.Build
import android.os.ParcelFileDescriptor
import android.content.pm.ServiceInfo
import java.io.FileInputStream
import java.io.FileOutputStream
import java.net.URL
import java.util.concurrent.Executors
import java.util.concurrent.atomic.AtomicBoolean
import javax.net.ssl.HttpsURLConnection

class AdBlockVpnService : VpnService() {

    private var vpnInterface: ParcelFileDescriptor? = null
    private var worker: Thread? = null

    private val running = AtomicBoolean(false)
    private val blocker = DnsBlocker()
    private val executor = Executors.newFixedThreadPool(4)
    private val outputLock = Any()

    override fun onStartCommand(
        intent: Intent?,
        flags: Int,
        startId: Int
    ): Int {
        when (intent?.action) {
            "STOP" -> {
                stopVpn()
                stopSelf()
            }

            "START" -> startVpn()
        }

        return START_NOT_STICKY
    }

    private fun createNotification(): Notification {
        val channelId = "ad_block_vpn"

        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.O) {
            val channel = NotificationChannel(
                channelId,
                "AD BLOCK Koruması",
                NotificationManager.IMPORTANCE_LOW
            )

            getSystemService(NotificationManager::class.java)
                .createNotificationChannel(channel)
        }

        val builder = if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.O) {
            Notification.Builder(this, channelId)
        } else {
            @Suppress("DEPRECATION")
            Notification.Builder(this)
        }

        return builder
            .setContentTitle("AD BLOCK")
            .setContentText("DNS koruması çalışıyor")
            .setSmallIcon(android.R.drawable.ic_lock_lock)
            .setOngoing(true)
            .build()
    }

    private fun startVpn() {
        if (running.get()) return

        try {
            val notification = createNotification()

            if (Build.VERSION.SDK_INT >= 34) {
                startForeground(
                    1,
                    notification,
                    ServiceInfo.FOREGROUND_SERVICE_TYPE_SPECIAL_USE
                )
            } else {
                startForeground(1, notification)
            }

            val builder = Builder()
                .setSession("AD BLOCK")
                .setMtu(1500)
                .addAddress("10.0.0.2", 32)
                .addDnsServer("1.1.1.1")
                .addRoute("1.1.1.1", 32)
                .addDisallowedApplication(packageName)

            vpnInterface = builder.establish()

            if (vpnInterface == null) {
                stopForeground(true)
                stopSelf()
                return
            }

            running.set(true)

            worker = Thread {
                readPackets()
            }.also { it.start() }

        } catch (e: Exception) {
            running.set(false)
            stopForeground(true)
            stopSelf()
        }
    }

    private fun readPackets() {
        val descriptor = vpnInterface ?: return

        try {
            val input = FileInputStream(descriptor.fileDescriptor)
            val output = FileOutputStream(descriptor.fileDescriptor)
            val buffer = ByteArray(32767)

            while (running.get()) {
                val length = input.read(buffer)

                if (length <= 0) continue

                val packet = buffer.copyOf(length)

                executor.execute {
                    processPacket(packet, output)
                }
            }

        } catch (e: Exception) {
            if (running.get()) {
                running.set(false)
                stopSelf()
            }
        }
    }

    private fun processPacket(
        packet: ByteArray,
        output: FileOutputStream
    ) {
        try {
            if (packet.size < 28) return

            val version = (packet[0].toInt() ushr 4) and 15
            if (version != 4) return

            if ((packet[9].toInt() and 255) != 17) return

            val ipLength = (packet[0].toInt() and 15) * 4
            if (ipLength < 20 || packet.size < ipLength + 8) return

            val udp = ipLength

            val destinationPort =
                ((packet[udp + 2].toInt() and 255) shl 8) or
                (packet[udp + 3].toInt() and 255)

            if (destinationPort != 53) return

            val dnsQuery = packet.copyOfRange(
                udp + 8,
                packet.size
            )

            val domain = DnsPacket.getDomain(dnsQuery) ?: return

            val dnsResponse = if (blocker.shouldBlock(domain)) {
                DnsPacket.blockedResponse(dnsQuery)
            } else {
                resolveDns(dnsQuery) ?: return
            }

            val responsePacket = buildResponsePacket(
                packet,
                ipLength,
                dnsResponse
            )

            synchronized(outputLock) {
                if (running.get()) {
                    output.write(responsePacket)
                }
            }

        } catch (_: Exception) {
        }
    }

    private fun resolveDns(query: ByteArray): ByteArray? {
        var connection: HttpsURLConnection? = null

        return try {
            connection = URL(
                "https://cloudflare-dns.com/dns-query"
            ).openConnection() as HttpsURLConnection

            connection.requestMethod = "POST"
            connection.connectTimeout = 5000
            connection.readTimeout = 5000
            connection.doOutput = true

            connection.setRequestProperty(
                "Content-Type",
                "application/dns-message"
            )

            connection.setRequestProperty(
                "Accept",
                "application/dns-message"
            )

            connection.outputStream.use {
                it.write(query)
            }

            if (connection.responseCode == 200) {
                connection.inputStream.use {
                    it.readBytes()
                }
            } else {
                null
            }

        } catch (_: Exception) {
            null
        } finally {
            connection?.disconnect()
        }
    }

    private fun buildResponsePacket(
        request: ByteArray,
        ipLength: Int,
        dns: ByteArray
    ): ByteArray {
        val udpLength = 8 + dns.size
        val result = ByteArray(ipLength + udpLength)

        System.arraycopy(request, 0, result, 0, ipLength)

        for (i in 0..3) {
            result[12 + i] = request[16 + i]
            result[16 + i] = request[12 + i]
        }

        result[2] = (result.size shr 8).toByte()
        result[3] = result.size.toByte()

        result[10] = 0
        result[11] = 0

        val udp = ipLength

        result[udp] = request[udp + 2]
        result[udp + 1] = request[udp + 3]
        result[udp + 2] = request[udp]
        result[udp + 3] = request[udp + 1]

        result[udp + 4] = (udpLength shr 8).toByte()
        result[udp + 5] = udpLength.toByte()
        result[udp + 6] = 0
        result[udp + 7] = 0

        System.arraycopy(
            dns,
            0,
            result,
            udp + 8,
            dns.size
        )

        var sum = 0L
        var i = 0

        while (i < ipLength) {
            sum +=
                ((result[i].toInt() and 255) shl 8) +
                (result[i + 1].toInt() and 255)
            i += 2
        }

        while ((sum shr 16) != 0L) {
            sum = (sum and 0xffff) + (sum shr 16)
        }

        val checksum = sum.inv().toInt() and 0xffff

        result[10] = (checksum shr 8).toByte()
        result[11] = checksum.toByte()

        return result
    }

    private fun stopVpn() {
        running.set(false)

        try {
            vpnInterface?.close()
        } catch (_: Exception) {
        }

        vpnInterface = null

        executor.shutdownNow()

        if (Build.VERSION.SDK_INT >= 24) {
            stopForeground(STOP_FOREGROUND_REMOVE)
        } else {
            @Suppress("DEPRECATION")
            stopForeground(true)
        }
    }

    override fun onDestroy() {
        stopVpn()
        super.onDestroy()
    }
}
