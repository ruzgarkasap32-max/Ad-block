
package com.example.ad_block

import android.app.Notification
import android.app.NotificationChannel
import android.app.NotificationManager
import android.app.PendingIntent
import android.content.Intent
import android.net.VpnService
import android.os.Build
import android.os.ParcelFileDescriptor
import java.io.FileInputStream
import java.io.FileOutputStream
import java.net.DatagramPacket
import java.net.DatagramSocket
import java.net.InetAddress
import java.util.concurrent.atomic.AtomicBoolean

class AdBlockVpnService : VpnService() {

    private var vpnInterface: ParcelFileDescriptor? = null
    private var worker: Thread? = null
    private val running = AtomicBoolean(false)
    private val blocker = DnsBlocker()

    override fun onStartCommand(
        intent: Intent?,
        flags: Int,
        startId: Int
    ): Int {
        if (intent?.action == "STOP") {
            stopVpn()
            stopSelf()
            return START_NOT_STICKY
        }

        if (!running.get()) {
            startForeground(1, createNotification())
            startVpn()
        }

        return START_STICKY
    }

    private fun createNotification(): Notification {
        val channelId = "ad_block_vpn"

        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.O) {
            val channel = NotificationChannel(
                channelId,
                "AD BLOCK Koruması",
                NotificationManager.IMPORTANCE_LOW
            )
            getSystemService(NotificationManager::class.java)
                .createNotificationChannel(channel)
        }

        val notificationIntent = packageManager
            .getLaunchIntentForPackage(packageName)

        val pendingIntent = PendingIntent.getActivity(
            this,
            0,
            notificationIntent,
            PendingIntent.FLAG_IMMUTABLE
        )

        return Notification.Builder(this, channelId)
            .setContentTitle("AD BLOCK")
            .setContentText("DNS koruması çalışıyor")
            .setSmallIcon(android.R.drawable.ic_lock_lock)
            .setContentIntent(pendingIntent)
            .setOngoing(true)
            .build()
    }

    private fun startVpn() {
        try {
            vpnInterface = Builder()
                .setSession("AD BLOCK")
                .addAddress("10.10.10.2", 32)
                .addDnsServer("10.10.10.1")
                .addRoute("10.10.10.1", 32)
                .establish()

            if (vpnInterface == null) {
                stopSelf()
                return
            }

            running.set(true)

            worker = Thread {
                readDnsPackets()
            }.also { it.start() }

        } catch (e: Exception) {
            running.set(false)
            stopSelf()
        }
    }

    private fun readDnsPackets() {
        val descriptor = vpnInterface ?: return
        val input = FileInputStream(descriptor.fileDescriptor)
        val output = FileOutputStream(descriptor.fileDescriptor)
        val buffer = ByteArray(32767)

        while (running.get()) {
            try {
                val length = input.read(buffer)
                if (length <= 0) continue

                val packet = buffer.copyOf(length)
                val response = processPacket(packet) ?: continue

                output.write(response)
            } catch (e: Exception) {
                if (running.get()) {
                    running.set(false)
                    stopSelf()
                }
            }
        }
    }

    private fun processPacket(packet: ByteArray): ByteArray? {
        if (packet.size < 28) return null
        if ((packet[0].toInt() shr 4) != 4) return null
        if (packet[9].toInt() != 17) return null

        val ipHeaderLength = (packet[0].toInt() and 15) * 4
        if (packet.size < ipHeaderLength + 8) return null

        val udpStart = ipHeaderLength
        val destinationPort =
            ((packet[udpStart + 2].toInt() and 255) shl 8) or
            (packet[udpStart + 3].toInt() and 255)

        if (destinationPort != 53) return null

        val dnsStart = udpStart + 8
        val dnsQuery = packet.copyOfRange(dnsStart, packet.size)
        val host = DnsPacket.getDomain(dnsQuery) ?: return null

        val dnsResponse = if (blocker.shouldBlock(host)) {
            DnsPacket.blockedResponse(dnsQuery)
        } else {
            forwardDns(dnsQuery) ?: return null
        }

        return buildResponsePacket(packet, ipHeaderLength, dnsResponse)
    }

    private fun forwardDns(query: ByteArray): ByteArray? {
        var socket: DatagramSocket? = null

        return try {
            socket = DatagramSocket()
            if (!protect(socket)) return null
            socket.soTimeout = 4000

            val server = InetAddress.getByName("1.1.1.1")
            socket.send(DatagramPacket(query, query.size, server, 53))

            val response = ByteArray(4096)
            val received = DatagramPacket(response, response.size)
            socket.receive(received)

            response.copyOf(received.length)
        } catch (e: Exception) {
            null
        } finally {
            socket?.close()
        }
    }

    private fun buildResponsePacket(
        request: ByteArray,
        ipLength: Int,
        dns: ByteArray
    ): ByteArray {
        val udpLength = 8 + dns.size
        val result = ByteArray(ipLength + udpLength)

        System.arraycopy(request, 0, result, 0, ipLength)

        for (i in 0 until 4) {
            result[12 + i] = request[16 + i]
            result[16 + i] = request[12 + i]
        }

        result[2] = ((result.size shr 8) and 255).toByte()
        result[3] = (result.size and 255).toByte()
        result[10] = 0
        result[11] = 0

        val udp = ipLength
        result[udp] = request[udp + 2]
        result[udp + 1] = request[udp + 3]
        result[udp + 2] = request[udp]
        result[udp + 3] = request[udp + 1]
        result[udp + 4] = ((udpLength shr 8) and 255).toByte()
        result[udp + 5] = (udpLength and 255).toByte()
        result[udp + 6] = 0
        result[udp + 7] = 0

        System.arraycopy(dns, 0, result, udp + 8, dns.size)

        return result
    }

    private fun stopVpn() {
        running.set(false)

        try {
            vpnInterface?.close()
        } catch (_: Exception) {
        }

        vpnInterface = null
        stopForeground(STOP_FOREGROUND_REMOVE)
    }

    override fun onDestroy() {
        stopVpn()
        super.onDestroy()
    }
}
